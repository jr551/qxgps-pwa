{
  "name": "qxgps-pwa",
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "description": "Ad-free PWA web client for QXGPS GPS trackers (read-only toward the vendor platform).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:web": "vite build",
    "build:android": "VITE_PLATFORM=android vite build && node scripts/sync-android-assets.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "relay": "node server/relay.mjs"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "preact": "10.25.4"
  },
  "devDependencies": {
    "@eslint/js": "9.15.0",
    "@types/leaflet": "1.9.14",
    "eslint": "9.15.0",
    "globals": "15.12.0",
    "typescript": "5.6.3",
    "typescript-eslint": "8.15.0",
    "vite": "5.4.11",
    "vite-plugin-pwa": "0.21.1",
    "vitest": "2.1.5"
  }
}
